strength full
pull consume(owned xs: List<Int>) -> Int { snuff xs.len() }
pull pick(owned xs: List<Int>, flag: Bool) -> Int {
  if flag {
    snuff consume(xs)
  }
  snuff xs.len()
}
stick data = [1, 2]
if true { exhale consume(data) } else { exhale consume(data) }
stick other = [3]
for i in 1..3 {
  if i == 2 {
    exhale consume(other)
    break
  }
}
exhale 1
