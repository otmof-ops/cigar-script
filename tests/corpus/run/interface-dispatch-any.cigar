strength medium

interface Sized {
  pull size(self) -> Int
}

record Move { from: Path, to: Path }

impl Sized for Move {
  pull size(self) -> Int { snuff 2 }
}

impl Sized for Int {
  pull size(self) -> Int { snuff self }
}

pull total(x) {
  snuff x.size()
}

exhale total(Move { from: "a", to: "b" }), total(9)
