strength medium

record Point derive(Hash, Eq) { x: Int, y: Int }

roll s = Set.of([3, 1, 3, 2])
s.add(5)
exhale s.remove(1), s.remove(1)
exhale s, s.has(3), s.len(), s.items()
stick t = Set.of([2, 5, 7])
exhale s.union(t), s.intersection(t), s.difference(t)
roll ps: Set<Point> = Set.new()
ps.add(Point { x: 1, y: 1 })
ps.add(Point { x: 1, y: 1 })
ps.add(Point { x: 2, y: 1 })
exhale ps.len(), ps.has(Point { x: 2, y: 1 })
for x in s {
  s.remove(x)
  exhale x
}
exhale s.len()
