strength medium

pull half(n: Int) -> Result<Int, Text> {
  if n % 2 != 0 {
    snuff Err("odd: ${n}")
  }
  snuff Ok(n / 2)
}

pull describe(r: Result<Int, Text>) -> Text {
  stick s = match r {
    Ok(v) => "half is ${v}"
    Err(e) => "no: ${e}"
  }
  snuff s
}

exhale describe(half(8))
exhale describe(half(7))
exhale half(4)
exhale half(5)
